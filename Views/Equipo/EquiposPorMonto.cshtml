@model IEnumerable<ClienteHTTPObligatorio.Models.DTOEquipo>
@{
    ViewData["Title"] = "Equipos con pagos únicos mayores a monto";
}

<h2>Consultar Equipos por Monto</h2>

<form method="get" asp-action="EquiposPorMonto">
    <div class="form-group">
        <label>Monto</label>
        <input type="number" step="0.01" class="form-control" name="monto" required />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Buscar</button>
</form>

@if (ViewBag.msg != null)
{
    <div class="alert alert-warning mt-3">@ViewBag.msg</div>
}

@if (Model != null && Model.Any())
{


    <h3 class="mt-4">Equipos encontrados: </h3>

    <table class="table table-striped mt-3">
        <thead>
        <tr>
            <th>Nombre del equipo</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var eq in Model)
        {
            <tr>
                <td>@eq.Nombre</td>
            </tr>
        }
        </tbody>
    </table>
}